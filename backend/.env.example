# ── Runtime ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development            # development | production | test
# STRICT_STARTUP=false             # abort startup when LLM/JWT config is missing (default: true in production)

# ── LLM provider (leave keys empty to run in degraded mode: question bank + heuristic scoring) ──
LLM_PROVIDER=groq                  # groq | gemini | none
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=30

# ── Embeddings / RAG ─────────────────────────────────────────────────────────
EMBEDDING_BACKEND=auto             # auto | gemini | hashing (auto = gemini when GEMINI_API_KEY is set)
EMBEDDING_DIM=768
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
RAG_MIN_SCORE=0.05

# ── Voice ────────────────────────────────────────────────────────────────────
VOICE_ENABLED=false
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Storage ──────────────────────────────────────────────────────────────────
# SQLite (default, zero setup):
DATABASE_URL=sqlite+aiosqlite:///./interviewai_dev.db
# PostgreSQL (docker compose up -d → port 5433):
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/interviewai
FAISS_PERSIST_DIR=./faiss_store
UPLOAD_DIR=./uploads

# ── HTTP / Auth ──────────────────────────────────────────────────────────────
PORT=8002
ENABLE_DOCS=true                   # /docs, /redoc (set false in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=
JWT_SECRET_KEY=change-me-to-a-long-random-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_REMEMBER_ME_EXPIRE_DAYS=90
# COOKIE_SECURE=true               # default: true in production
TRUSTED_PROXY=false

# ── Interview engine ─────────────────────────────────────────────────────────
ADAPTIVE_ENABLED=true
ADAPTIVE_DECREASE_MAX=4            # answer score (0-10) <= this → easier next question
ADAPTIVE_INCREASE_MIN=8            # answer score (0-10) >= this → harder next question
DEFAULT_QUESTIONS_PER_ROUND=5
MAX_QUESTIONS_PER_ROUND=12
DEFAULT_DSA_PROBLEMS=2
RUBRIC_WEIGHT_TECHNICAL=0.40
RUBRIC_WEIGHT_CONCEPTUAL=0.25
RUBRIC_WEIGHT_COMPLETENESS=0.20
RUBRIC_WEIGHT_COMMUNICATION=0.15

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC_LIMIT=30
RATE_LIMIT_PUBLIC_WINDOW=60
RATE_LIMIT_USER_LIMIT=100
RATE_LIMIT_USER_WINDOW=60
RATE_LIMIT_AUTH_IP_LIMIT=5
RATE_LIMIT_AUTH_ACCOUNT_LIMIT=5
RATE_LIMIT_UPLOAD_LIMIT=10
RATE_LIMIT_UPLOAD_WINDOW=3600
